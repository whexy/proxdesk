[Unit]
Description=Proxdesk VM self-service portal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=proxdesk
Group=proxdesk
WorkingDirectory=/opt/proxdesk/app
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/proxdesk/proxdesk.env
ExecStart=/opt/proxdesk/runtime/bin/node dist/proxdesk.js serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StateDirectory=proxdesk
StateDirectoryMode=0700
CacheDirectory=proxdesk
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
