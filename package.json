{
  "name": "proxdesk",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "proxdesk": "dist/proxdesk.js"
  },
  "scripts": {
    "dev": "node --import tsx bin/proxdesk.ts serve --dev --demo",
    "dev:live": "node --import tsx bin/proxdesk.ts serve --dev",
    "proxdesk": "node --import tsx bin/proxdesk.ts",
    "build": "next build && npm run build:cli",
    "build:cli": "esbuild bin/proxdesk.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/proxdesk.js \"--banner:js=#!/usr/bin/env node\"",
    "start": "NODE_ENV=production node dist/proxdesk.js serve",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/chat/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@next/env": "^16.0.0",
    "@novnc/novnc": "^1.6.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "openid-client": "^6.8.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
