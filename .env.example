# Proxdesk configuration. Every variable is described in docs/configuration.md.

# The address people open. Public addresses require HTTPS; private LAN HTTP is supported.
APP_ORIGIN=https://proxdesk.example.com
# Optional comma-separated extra addresses, such as a LAN address.
APP_ADDITIONAL_ORIGINS=
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/proxdesk.sqlite

# A dedicated, privilege-separated token; see docs/proxmox.md.
# Every secret below can instead be read from a file: PROXMOX_TOKEN_SECRET_FILE=/run/secrets/…
PROXMOX_URL=https://pve.example.com:8006
PROXMOX_TOKEN_ID=proxdesk@pve!portal
PROXMOX_TOKEN_SECRET=

# Trust a self-signed Proxmox certificate with one of these (see docs/proxmox.md):
# the CA that issued it, or the certificate's SHA-256 fingerprint.
PROXMOX_CA_FILE=
PROXMOX_FINGERPRINT=

# Defaults to a backups directory next to DATABASE_PATH.
BACKUP_DIR=

# Creates the first administrator on an empty database, unless you run
# `proxdesk create-admin` instead. Remove the password after initialization.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional single sign-on; see docs/sso.md.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional Slack bot (Socket Mode). See docs/chat.md.
# SLACK_CHANNEL_ID takes one channel ID or several separated by commas.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional Discord bot. See docs/chat.md.
# DISCORD_CHANNEL_IDS takes channel IDs separated by commas; required with the token.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=
# true also takes requests in direct messages to the bot; off by default.
DISCORD_ALLOW_DMS=

# Extension modules to load at startup: absolute paths or package names,
# separated by commas. They run with the server's full privileges; see
# docs/extending.md.
PROXDESK_EXTENSIONS=
